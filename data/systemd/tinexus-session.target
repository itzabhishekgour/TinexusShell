[Unit]
Description=Tinexus Desktop Session
Documentation=https://github.com/itzabhishekgour/TinexusShell
# Pulled in after graphical.target is reached on the system bus.
# On a systemd --user instance, this is After=basic.target.
After=graphical.target
Wants=tinexus-comp.service tinexus-serviced.service tinexus-shell.service tinexus-dock.service
# The session is only considered "up" when the compositor is running.
Requires=tinexus-comp.service
# Shell and dock are soft dependencies — the session survives their crash.

[Install]
WantedBy=graphical.target
