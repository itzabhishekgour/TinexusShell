[Unit]
Description=Tinexus Boot Splash Screen (/dev/fb0)
Documentation=https://github.com/itzabhishekgour/TinexusShell
# Splash runs directly on /dev/fb0 before the compositor is ready.
# It is stopped automatically the moment tinexus-comp.service reaches active state.
After=local-fs.target
Before=tinexus-comp.service
# When tinexus-comp becomes active, systemd stops this unit (ConflictedBy relationship
# is expressed via the Conflicts= directive on tinexus-comp if needed, or StopWhenUnneeded).
StopWhenUnneeded=yes

[Service]
Type=simple
User=root
ExecStart=/usr/bin/tinexus-splash
# Splash exits cleanly once SIGTERM arrives — no restart needed.
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=2

[Install]
WantedBy=tinexus-session.target
