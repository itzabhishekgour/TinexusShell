[Unit]
Description=Tinexus Dock (LiquidGlass Layer-Shell Dock)
Documentation=https://github.com/itzabhishekgour/TinexusShell
After=tinexus-comp.service tinexus-shell.service
BindsTo=tinexus-comp.service
PartOf=tinexus-session.target

[Service]
Type=simple
User=tinexus
Group=tinexus

EnvironmentFile=-/run/tinexus/env
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"

ExecStart=/usr/bin/tinexus-dock
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=2s
RestartSteps=3
RestartMaxDelaySec=20s

[Install]
WantedBy=tinexus-session.target
