[Unit]
Description=Tinexus Wayland Compositor (tinexus-comp)
Documentation=https://github.com/itzabhishekgour/TinexusShell
# Compositor must start after the graphics stack and input devices are probed.
# systemd-udev-settle.service ensures DRM nodes (/dev/dri/card*) exist.
After=systemd-udev-settle.service dbus.service tinexus-hardware-env.service
Requires=dbus.service
# The rest of the session depends on this unit.
PartOf=tinexus-session.target

[Service]
Type=simple
# Run as the Tinexus desktop user (UID 1000). Seat access is granted by logind/libseat.
User=tinexus
Group=tinexus

# wlroots needs the DRM/input device group memberships.
# libseat 'logind' backend calls into systemd-logind to take a seat session.
SupplementaryGroups=video input seat

# Environment: hardware renderer selection is performed by tinexus-hardware-env.service
# and published to /run/tinexus/env. We source that file here.
EnvironmentFile=-/run/tinexus/env

# Additional Wayland/Mesa paths that are compositor-specific.
Environment="LIBSEAT_BACKEND=logind"
Environment="WLR_LOG_LEVEL=info"
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"
Environment="LIBGL_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri:/usr/lib/dri"
Environment="GBM_BACKENDS_PATH=/usr/lib/x86_64-linux-gnu/gbm"
Environment="__EGL_VENDOR_LIBRARY_DIRS=/usr/share/glvnd/egl_vendor.d"
# XDG_RUNTIME_DIR is set by pam_systemd via the logind session.

ExecStart=/usr/bin/tinexus-comp
# Graceful stop: SIGTERM → 10-second grace → SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=10
# Auto-restart on crash with exponential backoff (matches old ProcessManager behaviour).
Restart=on-failure
RestartSec=2s
RestartSteps=4
RestartMaxDelaySec=32s

# Resource guard: compositor is a latency-sensitive real-time process.
# Nice=-5 keeps render loop responsive under load; OOMScoreAdjust keeps kernel from
# evicting it before user applications.
Nice=-5
OOMScoreAdjust=-200

# Security hardening: compositor still needs full /dev access for DRM/input.
PrivateTmp=false
ProtectSystem=no
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=tinexus-session.target
