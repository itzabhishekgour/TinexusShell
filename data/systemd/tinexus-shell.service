[Unit]
Description=Tinexus Shell (AuraNotch, Notification Center, Status Bar)
Documentation=https://github.com/itzabhishekgour/TinexusShell
After=tinexus-comp.service
BindsTo=tinexus-comp.service
PartOf=tinexus-session.target

[Service]
Type=simple
User=tinexus
Group=tinexus

EnvironmentFile=-/run/tinexus/env
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"

ExecStart=/usr/bin/tinexus-shell
KillSignal=SIGTERM
TimeoutStopSec=5
# Shell crash should not bring down the session — user can relaunch.
Restart=on-failure
RestartSec=2s
RestartSteps=3
RestartMaxDelaySec=20s

[Install]
WantedBy=tinexus-session.target
